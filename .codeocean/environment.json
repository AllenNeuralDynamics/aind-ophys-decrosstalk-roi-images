{
	"version": 1,
	"base_image": "codeocean/jupyterlab:3.6.1-miniconda4.12.0-python3.9-ubuntu20.04",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"pip": {
			"packages": [
				{
					"name": "aind-data-schema",
					"version": "1.1.0"
				},
				{
					"name": "aind-log-utils",
					"version": "0.2.1"
				},
				{
					"name": "aind-ophys-utils",
					"version": "0.0.7"
				},
				{
					"name": "aind-qcportal-schema",
					"version": "0.3.2"
				},
				{
					"name": "cellpose",
					"version": "2.2.3"
				},
				{
					"name": "h5py",
					"version": "3.10.0"
				},
				{
					"name": "matplotlib",
					"version": "3.7.3"
				},
				{
					"name": "numpy",
					"version": "1.24.4"
				},
				{
					"name": "pandas",
					"version": "2.0.3"
				},
				{
					"name": "scikit-image",
					"version": "0.21.0"
				},
				{
					"name": "suite2p",
					"version": "0.14.3"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	},
	"env_variables": [
		{
			"name": "PIPELINE_URL",
			"value": "https://codeocean.allenneuraldynamics.org/capsule/6127754/tree"
		},
		{
			"name": "PIPELINE_VERSION",
			"value": "1.0"
		},
		{
			"name": "VERSION",
			"value": "5.0"
		},
		{
			"name": "CELLPOSE_LOCAL_MODELS_PATH",
			"value": "/root/capsule"
		}
	]
}